# Machine-specific Android config (each dev generates their own)
local.properties

# Gradle build output & caches
.gradle/
build/
**/build/
.kotlin/

# IDE
.idea/
*.iml
.DS_Store

# Signing material — must NEVER be committed
*.jks
*.keystore
*.p12
*.pepk
keystore.properties

# Python
__pycache__/
*.pyc
.venv/

# Generated intermediates from asset tools (regenerate via tools/build.py)
watchfaces/*/tools/_work/
watchfaces/*/tools/out/

# OS / editor noise
*.swp
*~
Thumbs.db

# Disposable attitude-horizon spike build outputs (regenerable; the APKs are
# hashed in SPIKE_MANIFEST.json and rebuilt byte-identically from source).
/spikes/attitude-horizon/app/build/
/spikes/attitude-horizon/.gradle/
/spikes/attitude-horizon/local.properties
/spikes/attitude-horizon/**/__pycache__/

# ATTITUDE motion preview shell build outputs (regenerable; APK hashes are
# recorded in previews/attitude-motion-shell/BUILD_RECORD.json).
/previews/attitude-motion-shell/app/build/
/previews/attitude-motion-shell/.gradle/
/previews/attitude-motion-shell/local.properties
/previews/attitude-motion-shell/dist/
/previews/attitude-motion-shell/**/__pycache__/
